# Development defaults to the removable in-memory adapter; shared builds default to HTTP.
# Explicitly choose mock only for local demonstrations/tests.
VITE_DATA_ADAPTER=mock

# To exercise the final HTTP contract locally, set the adapter to http and
# start @lorestra/api. Keep cookies on the browser's same origin via /api.
VITE_LORESTRA_API_URL=/api

# Vite proxy destination. Server configuration only, never a browser credential.
LORESTRA_API_ORIGIN=http://127.0.0.1:8787
