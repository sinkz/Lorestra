{
  "name": "@lorestra/root",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "backend:init": "node scripts/backend-local.mjs init",
    "backend:seed": "node scripts/backend-local.mjs seed",
    "backend:dev": "node scripts/backend-local.mjs dev",
    "backend:session": "node scripts/backend-local.mjs session",
    "backend:readonly": "node scripts/backend-local.mjs readonly",
    "backend:backup": "node scripts/backend-backup.mjs create",
    "backend:restore": "node scripts/backend-backup.mjs restore",
    "backend:export": "node scripts/backend-backup.mjs export",
    "backend:import": "node scripts/backend-backup.mjs import",
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm deps:check && pnpm knip && pnpm peers:check && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --parallel --recursive --if-present dev",
    "deps:check": "depcruise --config .dependency-cruiser.cjs apps packages",
    "demo:webmcp": "pnpm --filter @lorestra/e2e --if-present run demo:webmcp",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "node scripts/check-unused.mjs",
    "lint": "eslint .",
    "peers:check": "pnpm peers check",
    "prepare": "husky",
    "test": "pnpm --recursive --if-present test && pnpm test:tooling",
    "test:tooling": "node --test --test-concurrency=1 --test-timeout=120000 scripts/backend-*.test.mjs",
    "test:e2e": "pnpm --filter @lorestra/e2e --if-present run test:e2e",
    "test:e2e:http": "pnpm --filter @lorestra/e2e run test:e2e:http",
    "test:e2e:http:smoke": "pnpm --filter @lorestra/e2e run test:e2e:http --grep @smoke",
    "test:e2e:http:mobile": "pnpm --filter @lorestra/e2e run test:e2e:http --project http-mobile",
    "test:mutation": "pnpm --filter @lorestra/api --if-present run test:mutation",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "miniflare": "5.20260828.0-alpha",
    "wrangler": "4.127.1",
    "yaml": "2.9.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "knip": "6.32.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
