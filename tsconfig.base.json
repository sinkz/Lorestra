{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@lorestra/contracts": ["packages/contracts/src/index.ts"],
      "@lorestra/contracts/*": ["packages/contracts/src/*"],
      "@lorestra/mock-vault": ["packages/mock-vault/src/index.ts"],
      "@lorestra/mock-vault/*": ["packages/mock-vault/src/*"]
    }
  }
}
